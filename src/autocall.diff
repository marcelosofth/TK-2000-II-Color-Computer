+// true so p/ "Desafio Fatal.ct2" (ou .zip com esse nome): ignora maiusculas,
+// espacos, "_" e "-" no nome do arquivo.
+bool current_tape_is_desafio_fatal() {
+	if (g_images.empty() || g_imageIndex >= g_images.size()) {
+		return false;
+	}
+	const std::string raw = baseName(g_images[g_imageIndex]);
+	std::string name;
+	for (char c : raw) {
+		if (std::isalnum((unsigned char)c)) {
+			name += (char)std::tolower((unsigned char)c);
+		}
+	}
+	return name.find("desafiofatal") != std::string::npos;
+}
