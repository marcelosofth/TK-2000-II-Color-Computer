// libretro core wrapper for the TK2000 emulation core (ported from
// https://github.com/fbelavenuto/tk2000, GPL-2.0).
//
// This file owns nothing but the libretro glue: translating retro_run()
// into CMachine::runFrame(), converting the SRGB framebuffer to XRGB8888,
// forwarding the frontend's keyboard callback into the TK2000 keyboard
// matrix, mapping a handful of joypad buttons to tape/reset controls, and
// (de)serializing savestates. All emulation logic lives in Machine.* and
// the classes it owns.

#include "pch.h"
#include "libretro.h"
#include "Machine.h"
#include "FilePicker.h"
#include "Credits.h"
#include "HostPaths.h"
#include "ZipTape.h"
