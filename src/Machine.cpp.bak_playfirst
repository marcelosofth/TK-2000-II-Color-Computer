/*************************************************************************************************/
CMachine::CMachine() {
	mBus.resetAll();
	mAudio.attach(this);
	mAudioAccum.reserve(NUMSAMPLESPERUPDATE);
}

/*************************************************************************************************/
void CMachine::notify(sAudioMsg& m) {
	// Called from CAudio::update() with whatever samples it generated
	// since the previous tick. Just append to this frame's accumulator;
	// libretro.cpp drains it once per retro_run() via takeAudioSamples().
	mAudioAccum.insert(mAudioAccum.end(), m.bufferPtr, m.bufferPtr + m.count);
}

/*************************************************************************************************/
void CMachine::runFrame(unsigned long cyclesPerFrame) {
	updateAutoType();
	updateOverlayTap();

	mAudioAccum.clear();
	const uint64_t startCycles = mCpu.getCumulativeCycles();
	while ((mCpu.getCumulativeCycles() - startCycles) < cyclesPerFrame) {
		mCpu.executeOpcode();
	}
	// Drive video/audio/tape device updates for the cycles just executed
	// (mirrors the original mBus.updateAll() call at the end of each CPU
	// worker-thread tick).
	mBus.updateAll(mCpu.getCumulativeCycles());
}

/*************************************************************************************************/
SRGB* CMachine::getFrameBuffer() {
	SRGB* fb = mVideo.getFrameBuffer();
	if (mOverlayActive) {
		drawKeyboardOverlay(fb);
	}
	return fb;
}

/*************************************************************************************************/
const int16_t* CMachine::takeAudioSamples(size_t& count) {
	count = mAudioAccum.size();
	const int16_t* ptr = mAudioAccum.empty() ? nullptr : mAudioAccum.data();
	return ptr;
}

/*************************************************************************************************/
void CMachine::softReset() {
	mBus.resetAll();
}

/*************************************************************************************************/
void CMachine::hardReset() {
	mRam.init();
	mLangCard.clearRam();
	mBus.resetAll();
}

/*************************************************************************************************/
void CMachine::keyEvent(bool down, unsigned keycode, uint16_t mod) {
	mKeyboard.keyEvent(down, keycode, mod);
}

/*************************************************************************************************/
void CMachine::queueAutoType(const char* text, int bootDelayFrames) {
	mAutoTypeText = text ? text : "";
	mAutoTypeIndex = 0;
	mAutoTypeState = EAutoTypeState::WaitBoot;
	mAutoTypeTimer = (bootDelayFrames >= 0) ? bootDelayFrames : kAutoTypeBootDelayFrames;
}

/*************************************************************************************************/
void CMachine::updateAutoType() {
	if (mAutoTypeState == EAutoTypeState::Idle) {
		return;
	}
	if (mAutoTypeTimer > 0) {
		mAutoTypeTimer--;
		return;
	}
	if (mAutoTypeState == EAutoTypeState::WaitBoot) {
		mAutoTypeState = EAutoTypeState::KeyDown;
		// fall through to press the first key this same frame
	}
	if (mAutoTypeState == EAutoTypeState::KeyDown) {
		if (mAutoTypeIndex >= mAutoTypeText.size()) {
			// Finished typing (e.g. "LOADT\n"). If a tape was actually
			// loaded, auto-press play a moment later instead of making
			// the user reach for the RetroPad A button themselves.
			if (mTapeLoaded) {
				mAutoTypeState = EAutoTypeState::WaitAutoPlay;
				mAutoTypeTimer = kAutoPlayDelayFrames;
			} else {
				mAutoTypeState = EAutoTypeState::Idle;
			}
			return;
		}
		mKeyboard.keyEvent(true, charToKeycode(mAutoTypeText[mAutoTypeIndex]), 0);
		mAutoTypeState = EAutoTypeState::KeyUp;
		mAutoTypeTimer = kAutoTypeKeyHoldFrames;
		return;
	}
	if (mAutoTypeState == EAutoTypeState::KeyUp) {
		mKeyboard.keyEvent(false, charToKeycode(mAutoTypeText[mAutoTypeIndex]), 0);
		mAutoTypeIndex++;
		mAutoTypeState = EAutoTypeState::KeyDown;
		mAutoTypeTimer = kAutoTypeKeyGapFrames;
		return;
	}
	if (mAutoTypeState == EAutoTypeState::WaitAutoPlay) {
		mTape.play();
		mAutoTypeState = EAutoTypeState::Idle;
		return;
	}
}

