	return true;
}

/*************************************************************************************************/
void CMachine::bootFromDisk() {
	// Real Disk ][ boot ROM behaviour: track 0 / sector 0's own first
	// byte says how many sectors of track 0 to load (normally just 1)
	// into consecutive pages starting at $0800; execution then continues
	// at $0801. From there on DOS 3.3's own RWTS (baked into the disk,
	// unmodified) drives $C0E0-$C0EF directly for everything else.
	const byte* sector0 = mDisk.rawTrack0Sector(0);
	byte sectorCount = sector0[0];
	if (sectorCount == 0 || sectorCount > CDisk::kSectorsPerTrack) {
		sectorCount = 1;
	}
	for (byte s = 0; s < sectorCount; s++) {
		memcpy(&mRam.mRam[0x0800 + s * 0x100], mDisk.rawTrack0Sector(s), CDisk::kSectorSize);
	}
	// This core only emulates the disk controller in slot 6 (see
	// Disk.h), so this is the same fixed $60 a real boot ROM in that
	// slot would use. Boot1 (loaded above, unmodified, at $0800) reads
	// it back out of A/X and/or zero page $2B -- both are set here
	// since which one a given DOS 3.3 boot1 variant relies on isn't
	// worth gambling on.
	constexpr byte kSlot16 = 0x60;
	mRam.mRam[0x2B] = kSlot16;
	// Real boot0 reads sector 0 through its own ($26/$27) destination
	// pointer, which is left pointing at the *next* page ($0900) when it
	// jumps to $0801. Boot1 checks for exactly that ($27 == $09) as its
	// very first instruction and, if so, runs its own setup: it works
	// out where the rest of the boot image goes ($08FE + $08FF -> page
	// $BE on this disk, counting down) and points its indirect
	// "ReadSector" vector ($3E/$3F) at this slot's $C65C. Without $27 ==
	// $09 that setup is skipped and every later page lands one page too
	// low -- see the $C65C trap in Cpu6502::executeOpcode() for what
	// actually answers those ReadSector calls, since this core has no
	// real ROM there.
	mRam.mRam[0x26] = 0x00;
	mRam.mRam[0x27] = 0x09;
	mCpu.setBootRegs(kSlot16, kSlot16, 0x00);
	mCpu.setPC(0x0801);
}

