	// Panel geometry: bottom of the 280x192 frame, centered horizontally.
	// kOverlayCols is the widest row in grid units (rows 0-2 are all 16
	// units wide: e.g. row0 = RESET(2) + ten digits(10) + REPEAT(2) +
	// RESET(2)); narrower rows (SHIFT row, SPACE bar) are centered
	// within that same panel width, same as on the real keyboard.
	constexpr int kOverlayCellW = 17;
	constexpr int kOverlayCellH = 18;
	constexpr int kOverlayCols = 16;
	constexpr int kOverlayPanelW = kOverlayCellW * kOverlayCols;
	constexpr int kOverlayPanelH = kOverlayCellH * kOverlayRowCount;
	constexpr int kOverlayX0 = (VIDEOWIDTH - kOverlayPanelW) / 2;
	constexpr int kOverlayY0 = VIDEOHEIGHT - kOverlayPanelH;

	inline void overlaySetPixel(SRGB* fb, int x, int y, SRGB c) {
		if (x < 0 || x >= VIDEOWIDTH || y < 0 || y >= VIDEOHEIGHT) {
			return;
		}
		fb[y * VIDEOWIDTH + x] = c;
	}
	inline void overlayFillRect(SRGB* fb, int x0, int y0, int w, int h, SRGB c) {
		for (int y = y0; y < y0 + h; y++) {
			for (int x = x0; x < x0 + w; x++) {
				overlaySetPixel(fb, x, y, c);
			}
		}
	}

	// Cursor-arrow icon: solid triangular head + straight shaft, drawn
	// pixel by pixel (1:1, no scaling) so it reads as a real arrow
	// instead of the cross-like shape the 3x5 font produced when
	// blown up. dir: 0=up, 1=down, 2=left, 3=right. Vertical arrows
	// are 9 wide x 10 tall, horizontal ones 10 x 9.
	inline void overlayDrawArrow(SRGB* fb, int x0, int y0, int dir, SRGB c) {
		for (int v = 0; v < 10; v++) {
			for (int u = 0; u < 9; u++) {
				int d = u - 4;
				if (d < 0) {
					d = -d;
				}
				const bool on = (v <= 4) ? (d <= v) : (d <= 1);
				if (!on) {
					continue;
				}
				const int vv = (dir == 1 || dir == 3) ? 9 - v : v;
				if (dir < 2) {
					overlaySetPixel(fb, x0 + u, y0 + vv, c);
				} else {
					overlaySetPixel(fb, x0 + vv, y0 + u, c);
				}
			}
		}
	}

	// Small text helper for the case-badge legend drawn above the key
	// grid (see drawKeyboardOverlay) -- reuses the 3x5 font, one glyph
	// per character with a 1px gap, spaces just advance the cursor.
	constexpr int kOverlayHeaderH = 9;	// badge text band, above the rainbow stripe
	constexpr int kOverlayTextScale = 1;

	int overlayTextWidth(const char* text) {
		int w = 0;
		for (const char* p = text; *p; p++) {
			w += 3 * kOverlayTextScale + 1;
		}
		return w > 0 ? w - 1 : 0;
	}
	void overlayDrawText(SRGB* fb, int x, int y, const char* text, SRGB color) {
		for (const char* p = text; *p; p++) {
			const char ch = (char)std::toupper((unsigned char)*p);
			const byte* glyphRows = findGlyph(ch);
			if (glyphRows) {
				for (int gy = 0; gy < 5; gy++) {
					for (int gx = 0; gx < 3; gx++) {
						if (glyphRows[gy] & (1 << (2 - gx))) {
							overlayFillRect(fb, x + gx * kOverlayTextScale, y + gy * kOverlayTextScale,
								kOverlayTextScale, kOverlayTextScale, color);
						}
					}
				}
			}
			x += 3 * kOverlayTextScale + 1;
		}
	}
