/*************************************************************************************************/
void CMachine::padEvent(bool left, bool right, bool up, bool down, bool button0, bool button1) {
	mJoystick.padEvent(left, right, up, down, button0, button1);
	// Real TK2000 FIRE keys are wired to both the joystick button lines
	// (above) and the keyboard matrix at once -- mirror that here so
	// games that poll the keyboard for FIRE (e.g. Bombardeiro.ct2)
	// respond to A/B the same as games that read $C061/$C062 directly.
	mKeyboard.fireKeyEvent(button0 || button1);
	// Same idea for movement: drive the LFT/RGT/DWN/UP cursor keys
	// alongside the paddle values, since some games (Bombardeiro.ct2
	// included) read those instead of $C064/$C065.
	mKeyboard.dirKeyEvent(left, right, up, down);
}

/*************************************************************************************************/
void CMachine::toggleKeyboardOverlay() {
	mOverlayActive = !mOverlayActive;
	if (mOverlayActive) {
		// Release whatever the joystick was doing at the moment the
		// overlay opens -- otherwise a direction held right as you
		// switch to typing would keep "steering" the paddle in the
		// background for as long as the overlay stays up.
		mJoystick.padEvent(false, false, false, false, false, false);
		mKeyboard.fireKeyEvent(false);
		mKeyboard.dirKeyEvent(false, false, false, false);
	}
}

/*************************************************************************************************/
void CMachine::overlayNavigate(bool left, bool right, bool up, bool down, bool select) {
	if (!mOverlayActive) {
		return;
	}

	int rowLen = kOverlayRows[mOverlayRow].count;
	if (left) {
		mOverlayCol = (mOverlayCol - 1 + rowLen) % rowLen;
	}
	if (right) {
		mOverlayCol = (mOverlayCol + 1) % rowLen;
	}
	if (up) {
		mOverlayRow = (mOverlayRow - 1 + kOverlayRowCount) % kOverlayRowCount;
	}
	if (down) {
		mOverlayRow = (mOverlayRow + 1) % kOverlayRowCount;
	}
	if (up || down) {
		const int newLen = kOverlayRows[mOverlayRow].count;
		if (mOverlayCol >= newLen) {
			mOverlayCol = newLen - 1;
		}
	}

	if (select) {
		const SOverlayKey& key = kOverlayRows[mOverlayRow].keys[mOverlayCol];
		if (key.isShift) {
			mOverlayShiftLatched = !mOverlayShiftLatched;
			return;
		}
		if (key.isControl) {
			// Unlike SHIFT (folded into the `mod` of every subsequent
			// tap), CTRL is its own held key on the real matrix -- send
			// it straight through so mCtrl flips immediately and stays
			// latched until CONTROL is selected again.
			mOverlayCtrlLatched = !mOverlayCtrlLatched;
			mKeyboard.keyEvent(mOverlayCtrlLatched, RETROK_LCTRL, 0);
			return;
		}
		if (key.keycode == 0) {
			// RESET / REPEAT: drawn for visual fidelity with the real
			// keyboard, but neither has a matrix cell to send (see the
			// comment above kOverlayRow0), so selecting them is a no-op.
			return;
		}
		// Tap: press now, release a few frames later via
		// updateOverlayTap() -- mirrors the auto-type state machine's
		// KeyDown/KeyUp pair above.
		mOverlayTapKeycode = key.keycode;
		mOverlayTapTimer = 4;
		const uint16_t mod = mOverlayShiftLatched ? RETROKMOD_SHIFT : 0;
		mKeyboard.keyEvent(true, mOverlayTapKeycode, mod);
	}
}

/*************************************************************************************************/
void CMachine::updateOverlayTap() {
	if (mOverlayTapTimer <= 0) {
		return;
	}
	mOverlayTapTimer--;
	if (mOverlayTapTimer == 0) {
		const uint16_t mod = mOverlayShiftLatched ? RETROKMOD_SHIFT : 0;
		mKeyboard.keyEvent(false, mOverlayTapKeycode, mod);
	}
}

/*************************************************************************************************/
void CMachine::drawKeyboardOverlay(SRGB* fb) {
	// Palette echoing the real TK2000's cream case / near-black keycaps
	// (see MicroDigital's original keyboard) instead of the old flat
	// blue-and-yellow scheme.
	const SRGB bg{ 214, 198, 152 };			// cream case
	const SRGB keyBg{ 34, 32, 30 };			// near-black keycap
	const SRGB keyBgShiftOn{ 150, 42, 30 };	// latched SHIFT: FIRE-red
	const SRGB selBg{ 232, 96, 28 };			// selection: FIRE-red/orange
	const SRGB keyEdgeHi{ 70, 68, 64 };		// keycap top/left bevel highlight
	const SRGB keyEdgeLo{ 12, 11, 10 };		// keycap bottom/right bevel shadow
	const SRGB glyphOn{ 230, 226, 216 };		// off-white legend
	const SRGB glyphOnSel{ 25, 15, 8 };		// dark legend on bright selection

	overlayFillRect(fb, kOverlayX0 - 2, kOverlayY0 - 2 - kOverlayHeaderH, kOverlayPanelW + 4, kOverlayPanelH + 4 + kOverlayHeaderH, bg);

	// Case-badge legend, like the "TK2000 color computer ... MICRODIGITAL"
	// text on the real unit's case, sitting just above the rainbow stripe.
	{
		const SRGB textColor{ 40, 34, 26 };
		const char* leftText = "TK 2000 II/Color Computer";
		const char* rightText = "MICRODIGITAL";
		const int textY = kOverlayY0 - 2 - kOverlayHeaderH + 2;
		overlayDrawText(fb, kOverlayX0 + 2, textY, leftText, textColor);
		overlayDrawText(fb, kOverlayX0 + kOverlayPanelW - 2 - overlayTextWidth(rightText), textY, rightText, textColor);
	}

	// Thin rainbow accent stripe along the top edge, echoing the badge
	// stripe on the real case (below the "TK2000 color computer" logo).
	// Inset a couple pixels from the cream panel's own left/right edges
	// -- flush with the panel edge, the case's tapered top corners (see
	// the bg fill above) clipped a sliver of the outer bands off past
	// the keyboard outline, which is what this margin avoids.
	{
		const SRGB stripe[] = {
			{ 200, 40, 40 }, { 224, 122, 30 }, { 224, 198, 40 }, { 60, 148, 72 }, { 42, 92, 188 },
		};
		constexpr int kBands = sizeof(stripe) / sizeof(stripe[0]);
		constexpr int kStripeH = 2;
		constexpr int kStripeInset = 3;
		const int stripeX0 = kOverlayX0 - 2 + kStripeInset;
		const int stripeW = kOverlayPanelW + 4 - 2 * kStripeInset;
		const int bandW = stripeW / kBands;
		for (int b = 0; b < kBands; b++) {
			// Last band absorbs the remainder from the division above,
			// so the bands' total width always lands exactly on
			// stripeX0 + stripeW -- never past it.
			const int w = (b == kBands - 1) ? (stripeW - bandW * (kBands - 1)) : bandW;
			overlayFillRect(fb, stripeX0 + b * bandW, kOverlayY0 - 2, w, kStripeH, stripe[b]);
		}
	}

	for (int r = 0; r < kOverlayRowCount; r++) {
		const SOverlayRow& row = kOverlayRows[r];
		// Total row width now varies per key (`units`), not just key
		// count -- sum it up so shorter rows (SHIFT row, SPACE bar)
		// still center within the panel, same as on the real keyboard.
		int rowW = 0;
		for (int c = 0; c < row.count; c++) {
			rowW += row.keys[c].units * kOverlayCellW;
		}
		const int rowX0 = kOverlayX0 + (kOverlayPanelW - rowW) / 2;
		int cx = rowX0;
		for (int c = 0; c < row.count; c++) {
			const SOverlayKey& key = row.keys[c];
			const int cellW = key.units * kOverlayCellW;
			const bool isSelected = (r == mOverlayRow && c == mOverlayCol);
			const bool isLatchedOn = (key.isShift && mOverlayShiftLatched) || (key.isControl && mOverlayCtrlLatched);
			const SRGB cellColor = isSelected ? selBg : (isLatchedOn ? keyBgShiftOn : keyBg);
			const int cy = kOverlayY0 + r * kOverlayCellH;
			const int kx = cx + 1, ky = cy + 1, kw = cellW - 2, kh = kOverlayCellH - 2;

			// Keycap body, with a 1px bevel (light top/left, dark
			// bottom/right) so keys read as raised caps rather than
			// flat tiles, like the sculpted keys on the real unit.
			overlayFillRect(fb, kx, ky, kw, kh, cellColor);
			if (!isSelected) {
				overlayFillRect(fb, kx, ky, kw, 1, keyEdgeHi);
				overlayFillRect(fb, kx, ky, 1, kh, keyEdgeHi);
				overlayFillRect(fb, kx, ky + kh - 1, kw, 1, keyEdgeLo);
				overlayFillRect(fb, kx + kw - 1, ky, 1, kh, keyEdgeLo);
			}

			const SRGB gcolor = isSelected ? glyphOnSel : glyphOn;
			if (key.label) {
				// Multi-letter keycap (RESET, REPEAT, FIRE, CONTROL,
				// SHIFT, RETURN, SPACE): center the text block in the cap.
				const int tw = overlayTextWidth(key.label);
				const int tx0 = cx + (cellW - tw) / 2;
				const int ty0 = cy + (kOverlayCellH - 5) / 2;
				overlayDrawText(fb, tx0, ty0, key.label, gcolor);
				cx += cellW;
				continue;
			}

			if (key.glyph == kGlyphUp || key.glyph == kGlyphDown ||
				key.glyph == kGlyphLeft || key.glyph == kGlyphRight) {
				const int dir = (key.glyph == kGlyphUp) ? 0 : (key.glyph == kGlyphDown) ? 1 :
					(key.glyph == kGlyphLeft) ? 2 : 3;
				const int bw = (dir < 2) ? 9 : 10;
				const int bh = (dir < 2) ? 10 : 9;
				overlayDrawArrow(fb, cx + (cellW - bw) / 2, cy + (kOverlayCellH - bh) / 2, dir, gcolor);
				cx += cellW;
				continue;
			}

			const byte* glyph7 = findGlyph5x7(key.glyph);
			if (glyph7) {
				const int scale = 2;
				const int gx0 = cx + (cellW - 5 * scale) / 2;
				const int gy0 = cy + (kOverlayCellH - 7 * scale) / 2;
				for (int gy = 0; gy < 7; gy++) {
					for (int gx = 0; gx < 5; gx++) {
						if (glyph7[gy] & (1 << (4 - gx))) {
							overlayFillRect(fb, gx0 + gx * scale, gy0 + gy * scale, scale, scale, gcolor);
						}
					}
				}
				cx += cellW;
				continue;
			}

			const byte* glyphRows = findGlyph(key.glyph);
			if (glyphRows) {
				const int scale = 3;
				const int gx0 = cx + (cellW - 3 * scale) / 2;
				const int gy0 = cy + (kOverlayCellH - 5 * scale) / 2;
				for (int gy = 0; gy < 5; gy++) {
					for (int gx = 0; gx < 3; gx++) {
						if (glyphRows[gy] & (1 << (2 - gx))) {
							overlayFillRect(fb, gx0 + gx * scale, gy0 + gy * scale, scale, scale, gcolor);
						}
					}
				}
			}
			cx += cellW;
		}
	}
}

/*************************************************************************************************/
// --- Savestate layout ---
// A fixed sequence of fixed-size POD blocks: CPU state, full 64KB RAM,
// video/audio/keyboard/tape state. No versioning beyond the overall
// size check — like most libretro cores, states are only expected to
// be compatible within the same core build.
namespace {
	struct SHeader {
		uint32_t magic;	// 'TK2K'
		uint32_t version;
	};
	constexpr uint32_t kMagic = 0x4B325454;	// "TTK2" little-endian-ish tag
	constexpr uint32_t kVersion = 3;	// bumped: added CLangCard::SState (64K/language card support) to the layout
}

size_t CMachine::stateSize() const {
	return sizeof(SHeader)
		+ sizeof(CCpu6502::SState)
		+ 0x10000	// RAM
		+ sizeof(CVideo::SState)
		+ sizeof(CAudio::SState)
		+ sizeof(CKeyboard::SState)
		+ sizeof(CTape::SState)
		+ sizeof(CJoystick::SState)
		+ sizeof(CLangCard::SState);
}

bool CMachine::saveState(void* data, size_t size) const {
	if (size < stateSize()) {
		return false;
	}
	uint8_t* p = static_cast<uint8_t*>(data);

	SHeader hdr{ kMagic, kVersion };
	memcpy(p, &hdr, sizeof(hdr)); p += sizeof(hdr);

	CCpu6502::SState cpuState = mCpu.saveState();
	memcpy(p, &cpuState, sizeof(cpuState)); p += sizeof(cpuState);

	memcpy(p, mRam.mRam, 0x10000); p += 0x10000;

	CVideo::SState videoState = mVideo.saveState();
	memcpy(p, &videoState, sizeof(videoState)); p += sizeof(videoState);

	CAudio::SState audioState = mAudio.saveState();
	memcpy(p, &audioState, sizeof(audioState)); p += sizeof(audioState);

	CKeyboard::SState kbState = mKeyboard.saveState();
	memcpy(p, &kbState, sizeof(kbState)); p += sizeof(kbState);

	CTape::SState tapeState = mTape.saveState();
	memcpy(p, &tapeState, sizeof(tapeState)); p += sizeof(tapeState);

	CJoystick::SState joyState = mJoystick.saveState();
	memcpy(p, &joyState, sizeof(joyState)); p += sizeof(joyState);

	CLangCard::SState langCardState = mLangCard.saveState();
	memcpy(p, &langCardState, sizeof(langCardState)); p += sizeof(langCardState);

	return true;
}

bool CMachine::loadState(const void* data, size_t size) {
	if (size < stateSize()) {
		return false;
	}
	const uint8_t* p = static_cast<const uint8_t*>(data);

	SHeader hdr{};
	memcpy(&hdr, p, sizeof(hdr)); p += sizeof(hdr);
	if (hdr.magic != kMagic || hdr.version != kVersion) {
		return false;
	}

	CCpu6502::SState cpuState{};
	memcpy(&cpuState, p, sizeof(cpuState)); p += sizeof(cpuState);
	mCpu.loadState(cpuState);

	memcpy(mRam.mRam, p, 0x10000); p += 0x10000;

	CVideo::SState videoState{};
	memcpy(&videoState, p, sizeof(videoState)); p += sizeof(videoState);
	mVideo.loadState(videoState);

	CAudio::SState audioState{};
	memcpy(&audioState, p, sizeof(audioState)); p += sizeof(audioState);
	mAudio.loadState(audioState);

	CKeyboard::SState kbState{};
	memcpy(&kbState, p, sizeof(kbState)); p += sizeof(kbState);
	mKeyboard.loadState(kbState);

	CTape::SState tapeState{};
	memcpy(&tapeState, p, sizeof(tapeState)); p += sizeof(tapeState);
	mTape.loadState(tapeState);

	CJoystick::SState joyState{};
	memcpy(&joyState, p, sizeof(joyState)); p += sizeof(joyState);
	mJoystick.loadState(joyState);

	CLangCard::SState langCardState{};
	memcpy(&langCardState, p, sizeof(langCardState)); p += sizeof(langCardState);
	mLangCard.loadState(langCardState);

	return true;
}
