	// Frame timing for the auto-type state machine, at the fixed 60fps
	// this core runs retro_run() at.
	constexpr int kAutoTypeBootDelayFrames = 90;	// ~1.5s: let the ROM finish its cold-boot before "typing"
	constexpr int kAutoTypeKeyHoldFrames   = 6;	// ~100ms key held down
	constexpr int kAutoTypeKeyGapFrames    = 6;	// ~100ms gap before the next key
	constexpr int kAutoPlayDelayFrames     = 30;	// ~0.5s pause after RETURN before auto-pressing play

	unsigned charToKeycode(char c) {
		c = (char)std::tolower((unsigned char)c);
		if (c == '\n' || c == '\r') {
			return RETROK_RETURN;
		}
		if (c >= 'a' && c <= 'z') {
			return RETROK_a + (c - 'a');
		}
		if (c >= '0' && c <= '9') {
			return RETROK_0 + (c - '0');
		}
		if (c == ' ') {
			return RETROK_SPACE;
		}
		return RETROK_UNKNOWN;
	}

	// --- On-screen keyboard overlay ---
	// Laid out to match the real TK2000 II keyboard 1:1 -- same keys,
	// same left-to-right order, same row groupings -- drawn directly
	// into the video frame and navigated with the D-pad, for setups
	// with no physical keyboard attached (see
	// CMachine::drawKeyboardOverlay/overlayNavigate).
	struct SOverlayKey {
		unsigned keycode;	// RETROK_* sent on tap; 0 for a key with no
							// matrix keycode of its own (see isShift/
							// isControl/label below)
		char glyph;		// single-glyph icon, looked up in kFont3x5
						// below (0 if this key uses `label` instead)
		const char* label;	// multi-letter keycap text, e.g. "RESET"
							// (nullptr if this key uses `glyph` instead)
		int units;		// keycap width, in grid columns (most keys are 1)
		bool isShift;	// latches mOverlayShiftLatched instead of tapping
		bool isControl;	// latches mOverlayCtrlLatched instead of tapping
	};
