static void poll_joypad_edges() {
	if (!g_input_state_cb) {
		return;
	}
	g_input_poll_cb();

	auto pressed = [](unsigned id) {
		return g_input_state_cb(0, RETRO_DEVICE_JOYPAD, 0, id) != 0;
	};

	bool a = pressed(RETRO_DEVICE_ID_JOYPAD_A);
	bool b = pressed(RETRO_DEVICE_ID_JOYPAD_B);
	bool select = pressed(RETRO_DEVICE_ID_JOYPAD_SELECT);
	bool start = pressed(RETRO_DEVICE_ID_JOYPAD_START);
	bool y = pressed(RETRO_DEVICE_ID_JOYPAD_Y);
	bool x = pressed(RETRO_DEVICE_ID_JOYPAD_X);
	bool l = pressed(RETRO_DEVICE_ID_JOYPAD_L);
	bool r = pressed(RETRO_DEVICE_ID_JOYPAD_R);
	bool up = pressed(RETRO_DEVICE_ID_JOYPAD_UP);
	bool down = pressed(RETRO_DEVICE_ID_JOYPAD_DOWN);
	bool left = pressed(RETRO_DEVICE_ID_JOYPAD_LEFT);
	bool right = pressed(RETRO_DEVICE_ID_JOYPAD_RIGHT);

	auto remember = [&]() {
		g_prevA = a;
		g_prevB = b;
		g_prevSelect = select;
		g_prevStart = start;
		g_prevY = y;
		g_prevX = x;
		g_prevL = l;
		g_prevR = r;
		g_prevUp = up;
		g_prevDown = down;
		g_prevLeft = left;
		g_prevRight = right;
	};

	// --- Tape picker window (START) ---
	if (start && !g_prevStart) {
		if (g_picker.isOpen()) {
			close_picker();
		} else {
			// The on-screen keyboard shares the D-pad/A: never both at once.
			if (g_machine->isKeyboardOverlayActive()) {
				g_machine->toggleKeyboardOverlay();
			}
			const bool haveCurrent = g_imageIndex < g_images.size();
			const std::string romsDir = find_roms_dir();
			tk2000_log("picker: roms dir = %s", romsDir.empty() ? "(not found)" : romsDir.c_str());
			g_picker.open(haveCurrent ? g_images[g_imageIndex] : std::string(), romsDir);
		}
	}
	if (g_picker.isOpen()) {
		CFilePicker::SInput in;
		in.up = up;
		in.down = down;
		in.left = left || l;
		in.right = right || r;
		in.ok = a;
		in.cancel = b;
		const CFilePicker::EResult res = g_picker.update(in);
		if (res == CFilePicker::EResult::Chosen) {
			const std::string path = g_picker.chosenPath();
			close_picker();
			pick_tape(path);
		} else if (res == CFilePicker::EResult::Cancelled) {
			close_picker();
		}
		// Keep the game's joystick/fire released while the window is up.
		g_machine->padEvent(false, false, false, false, false, false);
		remember();
		return;
	}
	if (g_padGate) {
		// The window just closed: the button that closed it (A/B/D-pad) is
		// probably still down. Don't let the game see it as a press.
		if (a || b || left || right || up || down) {
			a = b = left = right = up = down = false;
		} else {
			g_padGate = false;
		}
	}

	if ((l && !g_prevL) || (r && !g_prevR)) {
		// If the current cassette already ran to its end and there is a
		// next one in the playlist (.m3u / appended image), "pressing
		// play" now means: put tape 2 in the deck and start it. (With
		// the tape at its end play() would otherwise do nothing.)
		if (g_tapeEnded && !g_ejected && g_imageIndex + 1 < g_images.size()) {
			g_imageIndex++;
			if (!insertImageAt(g_imageIndex)) {
				g_imageIndex--;
			}
		}
		g_machine->tapePlay();
	}
	if (select && !g_prevSelect) {
		g_machine->hardReset();
	}
	if (y && !g_prevY) {
		cycle_fast_tape_speed();
	}
	if (x && !g_prevX) {
		g_machine->toggleKeyboardOverlay();
	}

	// D-pad (and A as "press") does double duty: it drives the native
	// joystick/paddle ports during gameplay, or navigates the on-screen
	// keyboard overlay while it's open -- never both at once.
	if (g_machine->isKeyboardOverlayActive()) {
		g_machine->overlayNavigate(
			left && !g_prevLeft, right && !g_prevRight,
			up && !g_prevUp, down && !g_prevDown,
			a && !g_prevA);
	} else {
		g_machine->padEvent(left, right, up, down, a, b);
	}

	remember();
}

void retro_run(void) {
	poll_joypad_edges();

	// While a tape is playing, burn through extra internal frames before
	// the one that actually gets displayed -- see the comment on
	// g_fastTapeMultiplier above. Re-checking tapePlaying() inside the
	// loop lets it stop the instant the tape finishes mid-burst instead
	// of overshooting into the next program state.
	if (g_machine->tapePlaying() && g_fastTapeMultiplier > 1) {
		int extraFrames = g_fastTapeMultiplier - 1;
		if (extraFrames > kFastTapeMaxExtraFrames) {
			extraFrames = kFastTapeMaxExtraFrames;
		}
		for (int i = 0; i < extraFrames && g_machine->tapePlaying(); i++) {
			g_machine->runFrame(kCyclesPerFrame);
		}
	}

	g_machine->runFrame(kCyclesPerFrame);

	// Remember when the cassette runs out (playing -> stopped), so that the
	// next "play" press can bring in tape 2 -- see poll_joypad_edges().
	{
		const bool playing = g_machine->tapePlaying();
		if (g_tapeWasPlaying && !playing) {
			g_tapeEnded = true;
		}
		g_tapeWasPlaying = playing;
	}

	// --- Video ---
	SRGB* fb = g_machine->getFrameBuffer();
	g_picker.draw(fb);	// tape picker window (no-op while closed)
	for (int i = 0; i < VIDEOWIDTH * VIDEOHEIGHT; i++) {
		g_videoBuf[i] = (uint32_t(fb[i].red) << 16) | (uint32_t(fb[i].green) << 8) | uint32_t(fb[i].blue);
	}
	if (g_video_cb) {
		g_video_cb(g_videoBuf.data(), VIDEOWIDTH, VIDEOHEIGHT, VIDEOWIDTH * sizeof(uint32_t));
	}

	// --- Audio (mono beeper -> duplicated to stereo) ---
	size_t count = 0;
	const int16_t* samples = g_machine->takeAudioSamples(count);
	if (samples && count > 0 && g_audio_batch_cb) {
		static std::vector<int16_t> stereo;
		stereo.resize(count * 2);
		for (size_t i = 0; i < count; i++) {
			stereo[i * 2 + 0] = samples[i];
			stereo[i * 2 + 1] = samples[i];
		}
		g_audio_batch_cb(stereo.data(), count);
	}
	// (The accumulator is cleared at the top of the next runFrame(), not here.)
}

