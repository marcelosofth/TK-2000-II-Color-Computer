// Implements the hook declared in CoreLog.h. Kept outside the anonymous
// namespace so Cpu6502.cpp / Tape.cpp (which only see CoreLog.h) can link
// against it, while still reading g_log_cb from this translation unit.
void tk2000_log(const char* fmt, ...) {
	char buf[256];
	va_list args;
	va_start(args, fmt);
	vsnprintf(buf, sizeof(buf), fmt, args);
	va_end(args);

	if (g_log_cb) {
		g_log_cb(RETRO_LOG_WARN, "[tk2000] %s\n", buf);
	}

	// Always also append to a fixed file next to the core, regardless of
	// whether the frontend wired up a working log interface -- some
	// frontends (this custom RetroArch shell included) silently drop
	// RETRO_ENVIRONMENT_GET_LOG_INTERFACE or never forward it anywhere
	// visible, which made every tk2000_log() call above a no-op in
	// practice. This file is the guaranteed fallback.
	//
	// NOTE: this used to fflush() on every single call. That's fine for
	// occasional events (traps, tape end-of-data) but AN0-AN2 ($C058-
	// $C05D) can be hit thousands of times a second by cassette bit-timing
	// loops (see Karateka), and fflush() forces a synchronous write to
	// disk on every call. That stalls the hot bus read/write path badly
	// enough to desync real-time-sensitive tape decoding -- which is what
	// was actually causing Karateka's "RETIRE SUA INTERFACE" screen, not
	// anything about the annunciator value itself. So: give the stream a
	// large buffer and let stdio coalesce writes; only force a flush
	// occasionally (in case of a crash we still lose at most one buffer's
	// worth) and unconditionally on shutdown (see retro_deinit).
	static FILE* debugLog = [] {
		FILE* f = fopen("tk2000_debug.log", "a");
		if (f) {
			static char ioBuf[1 << 16]; // 64 KiB
			setvbuf(f, ioBuf, _IOFBF, sizeof(ioBuf));
		}
		return f;
	}();
	if (debugLog) {
		fprintf(debugLog, "[tk2000] %s\n", buf);
		static int pending = 0;
		if (++pending >= 256) { // periodic safety flush, not per-call
			fflush(debugLog);
			pending = 0;
		}
	}
}

// Called from retro_deinit() so the tail of the log (whatever's still
// sitting in stdio's buffer since the last periodic flush above) actually
// makes it to disk instead of being lost when the core unloads.
void tk2000_log_flush() {
	// tk2000_log() owns `debugLog` as a function-local static; re-enter it
	// with nothing to print just to reach the same FILE* would be hacky,
	// so instead we just flush every open stream. Cheap, and only happens
	// once at shutdown.
	fflush(nullptr);
}

