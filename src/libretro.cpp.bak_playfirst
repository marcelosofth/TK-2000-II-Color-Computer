void show_message(const char* msg) {
	if (!g_environ_cb) {
		return;
	}
	struct retro_message rmsg;
	rmsg.msg = msg;
	rmsg.frames = 150;	// ~2.5s at 60fps -- readable but doesn't linger
	g_environ_cb(RETRO_ENVIRONMENT_SET_MESSAGE, &rmsg);
}

// --- Multi-image support (tape 1 / tape 2 ...) ---
// A game that comes on several cassette sides (e.g. Karateka: after side 1
// it asks "LIGUE O GRAVADOR E TECLE ESPACO" for side 2) is loaded through an
// .m3u playlist, or by appending a second image from the RetroArch menu
// (Disk Control -> Disk Image Append). Only tapes (.ct2) can be swapped at
// runtime; the machine is NOT reset on a swap -- the running program keeps
// going and just finds a different cassette in the deck.
std::vector<std::string> g_images;
unsigned g_imageIndex = 0;
bool g_ejected = false;
unsigned g_initialImage = 0;
bool g_tapeWasPlaying = false;
bool g_tapeEnded = false;	// tape ran to its end since it was (re)inserted

std::string baseName(const std::string& path) {
	const size_t pos = path.find_last_of("/\\");
	return pos == std::string::npos ? path : path.substr(pos + 1);
}

bool isAbsolutePath(const std::string& p) {
	return !p.empty() && (p[0] == '/' || p[0] == '\\' || (p.size() > 1 && p[1] == ':'));
}

// Reads an .m3u: one image per line, '#' lines are comments, relative
// entries are resolved against the playlist's own directory.
bool loadPlaylist(const char* m3uPath, std::vector<std::string>& out) {
	FILE* f = fopen(m3uPath, "rb");
	if (!f) {
		return false;
	}
	std::string dir;
	const std::string full = m3uPath;
	const size_t slash = full.find_last_of("/\\");
	if (slash != std::string::npos) {
		dir = full.substr(0, slash + 1);
	}
	std::string line;
	int c;
	auto flush = [&]() {
		while (!line.empty() && isspace((unsigned char)line.back())) line.pop_back();
		size_t b = 0;
		while (b < line.size() && isspace((unsigned char)line[b])) b++;
		line.erase(0, b);
		if (line.size() >= 3 && (unsigned char)line[0] == 0xEF && (unsigned char)line[1] == 0xBB && (unsigned char)line[2] == 0xBF) {
			line.erase(0, 3);	// UTF-8 BOM
		}
		if (!line.empty() && line[0] != '#') {
			out.push_back(isAbsolutePath(line) ? line : dir + line);
		}
		line.clear();
	};
	while ((c = fgetc(f)) != EOF) {
		if (c == '\n') {
			flush();
		} else {
			line.push_back((char)c);
		}
	}
	flush();
	fclose(f);
	return !out.empty();
}

// Inserts a tape given by path: a raw .ct2, or a .zip holding one.
bool loadTapeFile(const char* path) {
	if (!g_machine) {
		return false;
	}
	if (hasExtension(path, "zip")) {
		std::vector<unsigned char> data;
		return zipExtractFirstCt2(path, data) && g_machine->insertTapeData(data.data(), data.size());
	}
	return g_machine->insertTape(path);
}

// Puts image `index` in the tape deck (no reset). Returns false if the
// slot is empty / not a tape / unreadable.
bool insertImageAt(unsigned index, bool autoStart = false) {
	if (!g_machine || index >= g_images.size() || g_images[index].empty()) {
		return false;
	}
	const std::string& path = g_images[index];
	if (hasExtension(path.c_str(), "dsk")) {
		show_message("Troca de .dsk nao suportada: use fitas .ct2");
		return false;
	}
	if (!loadTapeFile(path.c_str())) {
		show_message("Falha ao ler a fita (.ct2 ou .zip com .ct2)");
		return false;
	}
	g_tapeEnded = false;
	g_tapeWasPlaying = false;
	static char buf[512];
	snprintf(buf, sizeof(buf), autoStart ? "Fita %u/%u: %s - carregando..."
		: "Fita %u/%u: %s - aperte L/R (play) e ESPACO",
		index + 1, (unsigned)g_images.size(), baseName(path).c_str());
	show_message(buf);
	tk2000_log("tape swapped to image %u/%u: %s", index + 1, (unsigned)g_images.size(), path.c_str());
	return true;
}

// --- retro_disk_control_* callbacks ---
bool RETRO_CALLCONV dc_set_eject_state(bool ejected) {
	if (ejected == g_ejected) {
		return true;
	}
	g_ejected = ejected;
	if (!ejected) {
		// "Insert": put whatever image is currently selected in the deck.
		insertImageAt(g_imageIndex);
	}
	return true;
}
bool RETRO_CALLCONV dc_get_eject_state(void) { return g_ejected; }
unsigned RETRO_CALLCONV dc_get_image_index(void) { return g_imageIndex; }
bool RETRO_CALLCONV dc_set_image_index(unsigned index) {
	g_imageIndex = index;
	return true;
}
unsigned RETRO_CALLCONV dc_get_num_images(void) { return (unsigned)g_images.size(); }
bool RETRO_CALLCONV dc_replace_image_index(unsigned index, const struct retro_game_info* info) {
	if (index >= g_images.size()) {
		return false;
	}
	if (!info || !info->path) {
		g_images.erase(g_images.begin() + index);
		if (g_imageIndex > 0 && g_imageIndex >= g_images.size()) {
			g_imageIndex = (unsigned)g_images.size() - (g_images.empty() ? 0 : 1);
		}
		return true;
	}
	g_images[index] = info->path;
	return true;
}
bool RETRO_CALLCONV dc_add_image_index(void) {
	g_images.emplace_back();
	return true;
}
bool RETRO_CALLCONV dc_set_initial_image(unsigned index, const char* /*path*/) {
	g_initialImage = index;
	return true;
}
bool RETRO_CALLCONV dc_get_image_path(unsigned index, char* s, size_t len) {
	if (index >= g_images.size() || g_images[index].empty() || !s || len == 0) {
		return false;
	}
	snprintf(s, len, "%s", g_images[index].c_str());
	return true;
}
bool RETRO_CALLCONV dc_get_image_label(unsigned index, char* s, size_t len) {
	if (index >= g_images.size() || g_images[index].empty() || !s || len == 0) {
		return false;
	}
	snprintf(s, len, "%s", baseName(g_images[index]).c_str());
	return true;
}

// --- Tape picker window (RetroPad START) ---
// START opens a file window over the video frame (see FilePicker.h) to pick
// the next cassette side, e.g. Karateka "disco 2" when the game asks
// "LIGUE O GRAVADOR E TECLE ESPACO". A = choose / enter folder, B or START =
// close. While it is open the game's own pad input is held released.
CFilePicker g_picker;
bool g_padGate = false;	// true after closing: ignore pad until every button is released
bool g_prevStart = false;
// After picking, the core answers the game's "tecle espaco" prompt itself:
// SPACE is typed after this many frames and the tape starts playing shortly
// after (same order as the LOADT auto-sequence). Set to false to only insert
// the tape and leave SPACE / play (L or R) to the player.
constexpr bool kPickerAutoStart = true;
constexpr int kPickerAutoStartDelayFrames = 20;

// Puts the picked tape in the deck (adding it to the image list, or reusing
// its slot if it's already there, so Disk Control stays in sync).
void pick_tape(const std::string& path) {
	if (!g_machine) {
		return;
	}
	if (g_images.empty()) {
		// Nothing loaded yet (core started without content): behave like
		// "Load Content" -- hard reset, insert and LOADT.
		struct retro_game_info info {};
		info.path = path.c_str();
		retro_load_game(&info);
		return;
	}
	unsigned idx = 0;
	bool found = false;
	for (unsigned i = 0; i < g_images.size(); i++) {
		if (g_images[i] == path) {
			idx = i;
			found = true;
			break;
		}
	}
	if (!found) {
		g_images.push_back(path);
		idx = (unsigned)g_images.size() - 1;
	}
	const unsigned prevIndex = g_imageIndex;
	const bool prevEjected = g_ejected;
	g_imageIndex = idx;
	g_ejected = false;
	if (!insertImageAt(idx, kPickerAutoStart)) {
		g_imageIndex = prevIndex;
		g_ejected = prevEjected;
		if (!found) {
			g_images.pop_back();
		}
		return;
	}
	if (kPickerAutoStart) {
		g_machine->queueAutoType(" ", kPickerAutoStartDelayFrames);
	}
}

// Where "roms/tk2000" lives. Looked up on every open (cheap) from: the
// working directory, the frontend executable, this core's own folder, and
// whatever folders the frontend reports (core path, system, save, content).
std::string find_roms_dir() {
	std::vector<std::string> bases;
	char cwd[1024];
	if (TK_GETCWD_CORE(cwd, sizeof(cwd))) {
		bases.push_back(cwd);
	}
	bases.push_back(hostExeDir());
	bases.push_back(hostCoreDir());
	if (g_environ_cb) {
		const char* dir = nullptr;
		if (g_environ_cb(RETRO_ENVIRONMENT_GET_LIBRETRO_PATH, &dir) && dir && *dir) {
			const std::string p = dir;
			const size_t pos = p.find_last_of("/\\");
			bases.push_back(pos == std::string::npos ? p : p.substr(0, pos));
		}
		for (unsigned cmd : { (unsigned)RETRO_ENVIRONMENT_GET_SYSTEM_DIRECTORY, (unsigned)RETRO_ENVIRONMENT_GET_SAVE_DIRECTORY,
				(unsigned)RETRO_ENVIRONMENT_GET_CONTENT_DIRECTORY }) {
			dir = nullptr;
			if (g_environ_cb(cmd, &dir) && dir && *dir) {
				bases.push_back(dir);
			}
		}
	}
	bases.erase(std::remove(bases.begin(), bases.end(), std::string()), bases.end());
	return CFilePicker::findRomsDir(bases);
}

void close_picker() {
	g_picker.close();
	g_padGate = true;
}

// Cycles Desligado -> 4x -> 8x -> 16x -> 32x -> Desligado -> ... and
// prints the new setting to the screen. Called on a Y button press.
void cycle_fast_tape_speed() {
	g_fastTapeSpeedIndex = (g_fastTapeSpeedIndex + 1) % kFastTapeSpeedCount;
	g_fastTapeMultiplier = kFastTapeSpeeds[g_fastTapeSpeedIndex];

	static char buf[64];
	snprintf(buf, sizeof(buf), "Velocidade de fita: %s", kFastTapeLabels[g_fastTapeSpeedIndex]);
	show_message(buf);
}

// Reads the tk2000_fast_tape_load core option (if the frontend exposes
// one, e.g. via a RetroArch submenu) just once, as the starting point
// for the in-game Y-button cycle -- not polled every frame, so pressing
// Y during play isn't immediately stomped back to whatever the menu
// still says.
void apply_initial_fast_tape_option() {
	if (!g_environ_cb) {
		return;
	}
	struct retro_variable var { "tk2000_fast_tape_load", nullptr };
	if (!g_environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) || !var.value) {
		return;
	}
	for (int i = 0; i < kFastTapeSpeedCount; i++) {
		bool isOff = (kFastTapeSpeeds[i] == 1) && (strcmp(var.value, "disabled") == 0);
		bool isMult = atoi(var.value) == kFastTapeSpeeds[i];
		if (isOff || isMult) {
			g_fastTapeSpeedIndex = i;
			g_fastTapeMultiplier = kFastTapeSpeeds[i];
			break;
		}
	}
}

