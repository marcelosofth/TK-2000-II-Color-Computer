// Case-insensitive "does this path end in .ext" check, used to tell a
// tape (.ct2) apart from a disk (.dsk) in retro_load_game() below.
bool hasExtension(const char* path, const char* ext) {
	if (!path) {
		return false;
	}
	const size_t pathLen = strlen(path);
	const size_t extLen = strlen(ext);
	if (pathLen < extLen + 1 || path[pathLen - extLen - 1] != '.') {
		return false;
	}
	const char* suffix = path + (pathLen - extLen);
	for (size_t i = 0; i < extLen; i++) {
		if (tolower((unsigned char)suffix[i]) != tolower((unsigned char)ext[i])) {
			return false;
		}
	}
	return true;
}

constexpr double kFps = 60.0;
constexpr unsigned long kCyclesPerFrame = (unsigned long)((double)CPU_CLOCK / kFps);

// --- Fast tape loading ---
// CTape::play()/CCpu6502::setFullSpeed() are a no-op in this port (the
// original SDL/Win32 app's main loop read CCpu6502::getClockRate() to
// decide how long to sleep between frames; nothing in the libretro loop
// ever calls it). So tape loading here always ran at strict real-time
// 1:1 with retro_run(), same as real hardware -- a ~2 minute cassette
// took ~2 real minutes of a static-colored screen.
//
// We run several internal CMachine::runFrame() calls per real
// retro_run() call while a tape is playing, and only push video/audio
// for the last one. CMachine already clears its audio accumulator at
// the top of every runFrame(), so the skipped frames' audio is
// discarded for free (i.e. the load screech is muted during turbo,
// same as other emulators' fast-load).
//
// Speed is cycled in-game with RetroPad Y (instead of only living in a
// RetroArch core-options submenu), with the current setting flashed on
// screen via RETRO_ENVIRONMENT_SET_MESSAGE so it's visible without
// opening any menu. The multiplier-per-frame values (index 0 = off)
// mirror the 16x/disabled/4x/8x/32x choices from the old core option,
// which still sets where the cycle *starts* (read once at load time)
// for frontends where remapping a button is inconvenient.
constexpr int kFastTapeSpeeds[] = { 1, 4, 8, 16, 32 };
constexpr const char* kFastTapeLabels[] = { "Desligado", "4x", "8x", "16x", "32x" };
constexpr int kFastTapeSpeedCount = sizeof(kFastTapeSpeeds) / sizeof(kFastTapeSpeeds[0]);
constexpr int kFastTapeMaxExtraFrames = 31;	// safety cap: 32x max, so a stuck tape can't hang retro_run()
constexpr int kFastTapeDefaultIndex = 3;		// 16x, if no core-option override is found at load time

int g_fastTapeSpeedIndex = kFastTapeDefaultIndex;
int g_fastTapeMultiplier = kFastTapeSpeeds[kFastTapeDefaultIndex];

