/*************************************************************************************************/
bool retro_load_game(const struct retro_game_info* game) {
	if (!g_machine) {
		g_machine = new CMachine();
	}
	g_picker.close();
	// Build the image list: a single .ct2/.dsk is a list of one; an .m3u
	// lists the tapes in order (tape 1, tape 2, ...). Image 0 (or the
	// frontend's remembered initial image) is what gets loaded below.
	g_images.clear();
	g_imageIndex = 0;
	g_ejected = false;
	g_tapeEnded = false;
	g_tapeWasPlaying = false;
	const char* loadPath = (game && game->path) ? game->path : nullptr;
	if (loadPath && hasExtension(loadPath, "m3u")) {
		if (!loadPlaylist(loadPath, g_images)) {
			show_message("Falha ao ler a playlist .m3u (vazia ou nao encontrada)");
			return false;
		}
		if (g_initialImage < g_images.size()) {
			g_imageIndex = g_initialImage;
		}
		loadPath = g_images[g_imageIndex].c_str();
	} else if (loadPath) {
		g_images.push_back(loadPath);
	}
	g_initialImage = 0;
	// g_machine can be reused across retro_load_game calls (loading a new
	// tape into an already-running core, e.g. via the frontend's "load
	// content" while a game is already playing). Without an explicit
	// reset here, the machine just keeps running in whatever state it was
	// already in -- screen not cleared, CPU wherever it left off -- and
	// the "LOADT" auto-type below goes nowhere useful. A real cassette
	// TK2000 is powered on with the tape already in the deck, so do the
	// equivalent here: hard-reset (clears RAM too) before inserting the
	// tape, every time a game is loaded, whether g_machine is fresh or not.
	g_machine->hardReset();
	// The keyboard overlay is a UI toggle, not per-game state -- if it
	// was left open from a previous game (or a previous load in the
	// same session, since g_machine is reused across retro_load_game
	// calls), force it closed here so a freshly loaded game always
	// starts with the D-pad/A driving the native joystick, not the
	// overlay grid.
	if (g_machine->isKeyboardOverlayActive()) {
		g_machine->toggleKeyboardOverlay();
	}
	static char msgBuf[512];
	bool isDisk = false;
	if (loadPath) {
		isDisk = hasExtension(loadPath, "dsk");
		if (isDisk) {
			if (g_machine->insertDisk(loadPath)) {
				snprintf(msgBuf, sizeof(msgBuf), "Disco carregado: %s", loadPath);
				if (g_log_cb) {
					g_log_cb(RETRO_LOG_INFO, "[tk2000] disk loaded: %s\n", loadPath);
				}
			} else {
				snprintf(msgBuf, sizeof(msgBuf),
					"Falha ao ler .dsk (precisa ter exatamente 143360 bytes, 35x16x256): %s", loadPath);
				if (g_log_cb) {
					g_log_cb(RETRO_LOG_ERROR, "[tk2000] failed to load disk (bad size or path is not a raw .dsk): %s\n", loadPath);
				}
				// Nothing to boot into -- leave the machine sitting at the
				// BASIC/monitor ROM, same as tape's failure path below.
			}
		} else if (loadTapeFile(loadPath)) {
			snprintf(msgBuf, sizeof(msgBuf), "Fita carregada: %s", loadPath);
			if (g_log_cb) {
				g_log_cb(RETRO_LOG_INFO, "[tk2000] tape loaded: %s\n", loadPath);
			}
		} else {
			snprintf(msgBuf, sizeof(msgBuf),
				"Falha ao ler .ct2 (arquivo invalido ou nao extraido do zip): %s", loadPath);
			if (g_log_cb) {
				g_log_cb(RETRO_LOG_ERROR, "[tk2000] failed to load tape (bad magic or path is not a raw .ct2): %s\n", loadPath);
			}
			// Still boot the machine to the BASIC/monitor ROM even if the
			// tape failed to parse — matches real hardware powering on
			// with a bad or no cassette inserted.
		}
		if (g_environ_cb) {
			struct retro_message msg;
			msg.msg = msgBuf;
			msg.frames = 300;	// ~5s on-screen at 60fps
			g_environ_cb(RETRO_ENVIRONMENT_SET_MESSAGE, &msg);
		}
	}
	// A disk boots straight into the game (see CMachine::bootFromDisk()),
	// so there's no "LOADT" to type and no tape to auto-play. Only queue
	// the auto-type/auto-play sequence for an actual tape load.
	if (!isDisk) {
		// Auto-type "LOADT" + RETURN a moment after boot; once that's done,
		// CMachine::updateAutoType() auto-presses play on its own (if a tape
		// was loaded), so no button press is needed. RetroPad A still works
		// as a manual play/pause toggle afterwards.
		g_machine->queueAutoType("LOADT\n");
	}

	apply_initial_fast_tape_option();
	return true;
}

