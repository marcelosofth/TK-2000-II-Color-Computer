	static const struct retro_disk_control_callback dcBasic = {
		dc_set_eject_state, dc_get_eject_state, dc_get_image_index, dc_set_image_index,
		dc_get_num_images, dc_replace_image_index, dc_add_image_index,
	};
	static const struct retro_disk_control_ext_callback dcExt = {
		dc_set_eject_state, dc_get_eject_state, dc_get_image_index, dc_set_image_index,
		dc_get_num_images, dc_replace_image_index, dc_add_image_index,
		dc_set_initial_image, dc_get_image_path, dc_get_image_label,
	};
	unsigned dcVersion = 0;
	if (cb(RETRO_ENVIRONMENT_GET_DISK_CONTROL_INTERFACE_VERSION, &dcVersion) && dcVersion >= 1) {
		cb(RETRO_ENVIRONMENT_SET_DISK_CONTROL_EXT_INTERFACE, (void*)&dcExt);
	} else {
		cb(RETRO_ENVIRONMENT_SET_DISK_CONTROL_INTERFACE, (void*)&dcBasic);
	}

	struct retro_log_callback logging;
	if (cb(RETRO_ENVIRONMENT_GET_LOG_INTERFACE, &logging)) {
		g_log_cb = logging.log;
	} else {
		g_log_cb = log_fallback;
	}
}

