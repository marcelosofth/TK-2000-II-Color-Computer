{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Debug smoke test — Windows",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/test/smoke_test.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "preLaunchTask": "Build core + smoke test (Windows)",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
